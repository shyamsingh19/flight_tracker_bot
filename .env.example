# Secrets only. Tunables live in config.toml. chmod 600 this file.
TELEGRAM_TOKEN=
IGNAV_API_KEY=
# Admin: your numeric Telegram user id (ask @userinfobot). Only the admin can use the bot.
ALLOWED_USER_ID=
# Extra ids that receive price alerts only (comma-separated). Optional; each must press Start once.
ALERT_USER_IDS=
# Dead-man's switch URL pinged every heartbeat_every_min (e.g. a healthchecks.io check). Optional.
HEARTBEAT_URL=
